{
  "name": "lumo",
  "productName": "Lumo",
  "version": "1.0.0",
  "description": "Lumo (by Proton) desktop app (Electron wrapper) by Adam And His Agents",
  "main": "src/main.js",
  "author": "Adam And His Agents (AAHA)",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.adamandhisagents.lumo",
    "productName": "Lumo",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Network",
      "icon": "icons",
      "executableName": "lumo",
      "artifactName": "lumo-aaha-${version}-${arch}.AppImage",
      "desktop": {
        "Name": "Lumo",
        "Comment": "Private AI assistant by Proton",
        "Categories": "Network;",
        "StartupWMClass": "Lumo"
      }
    }
  }
}
